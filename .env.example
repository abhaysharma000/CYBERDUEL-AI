# ==============================================================================
# CyberDuel AI - Environment Configuration Template
# Copy this file to .env for local development. Never commit production secrets.
# ==============================================================================

# Core Application Settings
APP_NAME=CyberDuel AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# API Service
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_insecure_secret_change_in_production_32chars_min!
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=1048576

# Security & CORS (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Database Configuration (PostgreSQL)
# Async URL for FastAPI asyncpg; Sync URL for Alembic migrations
POSTGRES_USER=cyberduel
POSTGRES_PASSWORD=cyberduel_dev_secret
POSTGRES_DB=cyberduel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cyberduel:cyberduel_dev_secret@localhost:5432/cyberduel_db
DATABASE_URL_SYNC=postgresql+psycopg://cyberduel:cyberduel_dev_secret@localhost:5432/cyberduel_db

# Background Task Queue / Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: mock, local, openai, anthropic
AI_PROVIDER_TYPE=mock
AI_API_KEY=
AI_MODEL_NAME=deterministic-mock-v1
AI_REASONING_TEMPERATURE=0.2

# Laboratory Worker Settings (Controlled & Sandboxed)
LAB_WORKER_ENABLED=true
LAB_SANDBOX_STRICT=true
LAB_MAX_CONCURRENT_EXPERIMENTS=2
LAB_EXECUTION_TIMEOUT_SECONDS=60
LAB_ALLOW_EXTERNAL_NETWORK=false

# Release Management & Verification (Public Key for release verification)
RELEASE_VERIFICATION_KEY_ID=dev-master-key-01
RELEASE_VERIFICATION_PUBLIC_KEY=

