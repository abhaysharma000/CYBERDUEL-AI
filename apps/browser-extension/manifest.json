{
  "manifest_version": 3,
  "name": "CyberDuel AI — Navigation Guard & Threat Defense",
  "version": "1.0.0",
  "description": "Continuous client-side navigation protection, local URL threat evaluation, signed policy updates, and zero-executable update verification.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "activeTab",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["link-guard.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CyberDuel AI Protection"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "minimum_chrome_version": "110"
}

