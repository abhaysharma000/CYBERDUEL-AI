{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "(cd apps/dashboard 2>/dev/null || cd ../apps/dashboard) && npm install && npm run build && (mkdir -p ../api/apps/dashboard && cp -r dist ../api/apps/dashboard/ 2>/dev/null || true)",
  "outputDirectory": "apps/dashboard/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{apps/api/**,packages/**,services/**,datasets/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|docs|redoc|openapi.json).*)",
      "destination": "/index.html"
    }
  ]
}

